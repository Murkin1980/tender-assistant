# Copy to /etc/tender-assistant/production.env and protect with chmod 0600.
# Replace the example domain and email with the hostname/operator contact for this VM.
APP_DOMAIN=app.example.com
APP_ORIGIN=https://app.example.com
ACME_EMAIL=operator@example.com
OPERATOR_USERNAME=operator
# Generate interactively with: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
OPERATOR_PASSWORD_HASH='replace-with-the-bcrypt-hash-from-caddy'
# The file contains only the Goszakup OWS bearer token and must be mode 0600.
GOSZAKUP_TOKEN_FILE=/etc/tender-assistant/secrets/goszakup_token
