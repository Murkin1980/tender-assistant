{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tender-assistant-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "tender-assistant-api",
    },
  ],
  "routes": [
    {
      "pattern": "tender.salamat-mebel.kz",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
