{
  "name": "@tender-assistant/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs,json,css}\" \"test/**/*.{ts,tsx}\" \"next.config.ts\" \"vitest.config.mts\" \"tsconfig.json\" \"eslint.config.mjs\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs,json,css}\" \"test/**/*.{ts,tsx}\" \"next.config.ts\" \"vitest.config.mts\" \"tsconfig.json\" \"eslint.config.mjs\" \"package.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
