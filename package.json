{
  "name": "tender-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tender-assistant/backend --filter @tender-assistant/frontend dev",
    "build": "pnpm --recursive --if-present build",
    "build:cloudflare": "pnpm --filter @tender-assistant/backend build && pnpm --filter @tender-assistant/frontend build:cloudflare",
    "lint": "pnpm --recursive --if-present lint",
    "format": "pnpm --recursive --if-present format",
    "format:check": "pnpm --recursive --if-present format:check",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --parallel --filter @tender-assistant/backend --filter @tender-assistant/frontend test",
    "test:e2e": "pnpm --filter @tender-assistant/backend test:e2e"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
