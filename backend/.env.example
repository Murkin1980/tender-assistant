NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Source of the public /lots data path. Backend-only: a browser cannot switch it with a query
# parameter. `fixture` (default) serves the deterministic CP-03 demo records; `goszakup` serves
# read-only, bounded live data from the official OWS v3 registry and needs GOSZAKUP_TOKEN.
# Any other value fails configuration validation at startup.
TENDER_LOT_SOURCE=fixture

# Optional read-only access to the official Goszakup OWS v3 GraphQL registry.
# Backend-only: the token is never exposed to the frontend and never leaves the server.
# Required only for TENDER_LOT_SOURCE=goszakup; a real token must never be committed.
GOSZAKUP_TOKEN=
# Optional overrides; the defaults are the official v3 endpoint and a 15s request bound.
GOSZAKUP_GRAPHQL_URL=https://ows.goszakup.gov.kz/v3/graphql
GOSZAKUP_TIMEOUT_MS=15000
