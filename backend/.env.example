NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Optional read-only access to the official Goszakup OWS v3 GraphQL registry.
# Backend-only: the token is never exposed to the frontend and never leaves the server.
# Leave empty unless you have your own OWS token; a real token must never be committed.
GOSZAKUP_TOKEN=
# Optional overrides; the defaults are the official v3 endpoint and a 15s request bound.
GOSZAKUP_GRAPHQL_URL=https://ows.goszakup.gov.kz/v3/graphql
GOSZAKUP_TIMEOUT_MS=15000
